# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser. Used for admin actions like
# inviting clients. (Project Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full site URL, used to build the redirect link sent in client invite emails.
# Use http://localhost:3000 for local dev, your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com booking page link, e.g. https://cal.com/your-username/intro-call
NEXT_PUBLIC_CAL_COM_LINK=https://cal.com/your-username/intro-call

# Resend API key, used to send one-off service enquiry emails.
# Sign up at resend.com and create an API key under API Keys.
RESEND_API_KEY=your-resend-api-key

# Optional — the "From" address enquiry emails are sent from. Defaults to
# Resend's shared sandbox address, which works without any domain setup as
# long as enquiries are always sent to your own Resend account email.
# Once you verify a domain in Resend, you can switch this to an address
# on your own domain, e.g. "Arzuno Fitness <enquiries@arzuno.co.uk>".
RESEND_FROM_EMAIL=Arzuno Fitness <onboarding@resend.dev>
